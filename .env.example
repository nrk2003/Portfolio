# Public URL of the deployed site, used for canonical URLs, Open Graph, sitemap and robots.txt.
# Optional on Vercel: if unset, the production deployment URL Vercel provides is used.
# Example: NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_SITE_URL=

# Microsoft Clarity project ID (clarity.microsoft.com → your project → Settings → Overview).
# Analytics load only in production builds when this is set.
NEXT_PUBLIC_CLARITY_PROJECT_ID=
